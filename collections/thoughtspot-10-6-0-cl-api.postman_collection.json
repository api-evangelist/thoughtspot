            "body": {
              "mode": "raw",
              "raw": "{\n  \"headers_update\": [\n    {\n      \"attributes\": [\n        {\n          \"name\": \"<string>\",\n          \"value\": \"<string>\"\n        },\n        {\n          \"name\": \"<string>\",\n          \"value\": \"<string>\"\n        }\n      ],\n      \"identifier\": \"<string>\",\n      \"obj_identifier\": \"<string>\",\n      \"type\": \"<string>\"\n    },\n    {\n      \"attributes\": [\n        {\n          \"name\": \"<string>\",\n          \"value\": \"<string>\"\n        },\n        {\n          \"name\": \"<string>\",\n          \"value\": \"<string>\"\n        }\n      ],\n      \"identifier\": \"<string>\",\n      \"obj_identifier\": \"<string>\",\n      \"type\": \"<string>\"\n    }\n  ],\n  \"org_identifier\": \"<string>\"\n}",
