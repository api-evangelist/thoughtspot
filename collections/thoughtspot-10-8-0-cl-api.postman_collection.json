              "raw": "{\n  \"metadata\": [\n    {\n      \"new_obj_id\": \"<string>\",\n      \"metadata_identifier\": \"<string>\",\n      \"type\": \"<string>\",\n      \"current_obj_id\": \"<string>\"\n    },\n    {\n      \"new_obj_id\": \"<string>\",\n      \"metadata_identifier\": \"<string>\",\n      \"type\": \"<string>\",\n      \"current_obj_id\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
