                              "raw": "{\n  \"metadata_identifier\": \"<string>\",\n  \"field_type\": \"ATTRIBUTE\",\n  \"field_name\": \"<string>\",\n  \"variable_identifier\": \"<string>\",\n  \"metadata_type\": \"CONNECTION_CONFIG\"\n}",
