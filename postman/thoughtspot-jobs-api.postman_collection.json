                                          "key": "Content-Type",
                                          "value": "application/json"
                                        }
                                      ],
                                      "cookie": [],
                                      "responseTime": null,
                                      "body": "{\n  \"jobs\": [\n    {\n      \"id\": \"<string>\",\n      \"status\": \"SUCCESS\",\n      \"creation_time_in_millis\": \"<float>\",\n      \"event\": {\n        \"type\": \"LIVEBOARD_SCHEDULE\",\n        \"id\": \"<string>\",\n        \"name\": \"<string>\",\n        \"run_id\": \"<string>\"\n      },\n      \"recipients\": [\n        {\n          \"type\": \"EXTERNAL\",\n          \"id\": \"<string>\",\n          \"name\": \"<string>\",\n          \"email\": \"<string>\"\n        },\n        {\n          \"type\": \"EXTERNAL\",\n          \"id\": \"<string>\",\n          \"name\": \"<string>\",\n          \"email\": \"<string>\"\n        }\n      ],\n      \"detail\": \"<string>\",\n      \"try_count\": \"<integer>\"\n    },\n    {\n      \"id\": \"<string>\",\n      \"status\": \"RETRY\",\n      \"creation_time_in_millis\": \"<float>\",\n      \"event\": {\n        \"type\": \"LIVEBOARD_SCHEDULE\",\n        \"id\": \"<string>\",\n        \"name\": \"<string>\",\n        \"run_id\": \"<string>\"\n      },\n      \"recipients\": [\n        {\n          \"type\": \"USER\",\n          \"id\": \"<string>\",\n          \"name\": \"<string>\",\n          \"email\": \"<string>\"\n        },\n        {\n          \"type\": \"EXTERNAL\",\n          \"id\": \"<string>\",\n          \"name\": \"<string>\",\n          \"email\": \"<string>\"\n        }\n      ],\n      \"detail\": \"<string>\",\n      \"try_count\": \"<integer>\"\n    }\n  ]\n}",
