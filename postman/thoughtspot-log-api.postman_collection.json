                              "raw": "{\n  \"log_type\": \"SECURITY_AUDIT\",\n  \"start_epoch_time_in_millis\": \"<float>\",\n  \"end_epoch_time_in_millis\": \"<float>\",\n  \"get_all_logs\": true\n}",
